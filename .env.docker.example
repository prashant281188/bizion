# ==============================================================================
# Docker Compose Environment Configuration Example
# Copy to .env.docker or .env to customize
# ==============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bizion
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Backend
NODE_ENV=production
JWT_SECRET=replace-with-at-least-16-characters-secret
JWT_REFRESH_SECRET=replace-with-at-least-16-characters-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AWS S3 (Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bizion-uploads

# SMTP Email (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
SMTP_FROM="Bizion Support" <no-reply@yourdomain.com>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
